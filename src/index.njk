<script>
  function startStopwatch(id, since) {
    setInterval(function () {
      var difference = Date.now() - since;
      var seconds = Math.floor(difference / 1000);
      var minutes = Math.floor(seconds / 60);
      var hours = Math.floor(minutes / 60);
      var days = Math.floor(hours / 24);
      var years = Math.floor(days / 365);
      document.getElementById(id).innerText =
        years + "y, " + (days % 365) + "d, " + (hours % 24) + "h, " + (minutes % 60) + "m, " + (seconds % 60) + "s";
    }, 1000);
  }
  startStopwatch("stopwatch-1342569600000", 1342569600000);
  startStopwatch("stopwatch-1482969600000", 1482969600000);
</script>

