---
import Layout from "../layouts/Layout.astro";

import Experience from "../components/Experience.astro";
import Project from "../components/Project.astro";
import Stopwatch from "../components/Stopwatch.astro";

const articleImports = Object.values(import.meta.glob("./*.md"));
const articles: any[] = await Promise.all(
  articleImports.map((article) => article()),
);
---

<Layout
  title="Richard Grover - Home Page"
  description="Hello, I'm Richard Grover. I'm an engineer at Dreamwalk Park. Learn more about me here!"
>
  <section></section>

  <div class="row col-if-tablet black-corners">
    <section>
      <div>
        <h2>Hello, I'm</h2>
        <a href="/">
          <img
            src="/richard-black.png"
            alt="Richard Grover"
            style="max-height: 150px"
          />
        </a>

        <br />
        <br />

        I build immersive and interactive experiences at
        <a href="https://dreamwalk.com/" target="_blank">DreamWalk Park</a>
      </div>
    </section>
    <section>
      <div>
        <div class="flex w-full flex-col gap-1">
          <h2>Statistics</h2>
          <p>
            Building for <Stopwatch since={Date.UTC(2012, 6, 18)} />
            Programming for <Stopwatch since={Date.UTC(2017, 0, 0)} />
          </p>
          <ul>
            <li>At age 12, I wrote my first line of code</li>
            <li>At age 17, I founded a gaming startup that got acquired</li>
            <li>
              At age 19, I deployed a software-hardware product to venues across
              Utah
            </li>
            <li>
              Now, I build immersive & interactive experiences at
              <a href="https://dreamwalk.com/" target="_blank">DreamWalk Park</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <section>
    <h2 class="text-center">Projects</h2>
  </section>

  <Project name="simulo" src="projects/simulo/0.png" alt="Simulo Banner">
    Interactive projection technology deployed to public venues across Utah,
    including the largest aquarium in the state.

    <p class="text-center">
      <a href="https://simulo.tech/"> Website </a>
      <a href="https://github.com/richgrov/simulo" style="padding-left: 1rem">
        View on GitHub
      </a>
      <a
        href="https://www.youtube.com/watch?v=3ZshR_2w_GI"
        style="padding-left: 1rem">Documentary</a
      >
    </p>
  </Project>

  <Project
    name="dCubed"
    src={["projects/dCubed/0.webm", "projects/dCubed/0.mp4"]}
    width={1222}
    height={706}
  >
    A Rubik's Cube solver powered by computer vision.
    <span class="fire-text"><strong>1st place</strong></span> at my college's project
    showcase!

    <p>
      <a href="https://github.com/richgrov/dCubed" class="text-center"
        >View on GitHub</a
      >
    </p>
  </Project>

  <Project
    name="Rethinking Webdev with HTMX"
    src="projects/htmx/htmx.jpg"
    alt="Presenting at the meetup"
  >
    A talk I gave at the
    <a href="https://www.meetup.com/reactjs-utah/">React Utah Meetup</a> to discuss
    the HTMX library.

    <p class="text-center">
      <a
        href="https://www.linkedin.com/feed/update/urn:li:activity:7250701422923558912/"
        >LinkedIn</a
      >
      <a
        href="https://github.com/richgrov/talks/tree/main/htmx"
        style="padding-left: 1rem">Resources on Github</a
      >
    </p>
  </Project>

  <Project
    name="vkad"
    src={[
      "https://project-videos.grover.sh/vkad/0.webm",
      "https://project-videos.grover.sh/vkad/0.mp4",
    ]}
  >
    A Vulkan-based CAD program capable of creating 3D-printable models.

    <p>
      <a href="https://github.com/richgrov/simulo" class="text-center"
        >View on GitHub</a
      >
    </p>
  </Project>

  <Project name="T10" src="/projects/t10/0.jpg">
    A robotic arm with custom printed parts and firmware made from scratch with
    first principles.

    <p>
      <a href="https://github.com/richgrov/T10" class="text-center"
        >View on GitHub</a
      >
    </p>
  </Project>

  <Project
    name="Robo-Remote"
    src="projects/robo-remote/0.jpg"
    alt="A phone remote controlling the Unitree GO2 Robot Dog"
  >
    A custom mobile app to control the Unitree GO2 Robot Dog using a
    reverse-engineered protocol
  </Project>

  <section>
    <h2 class="text-center">Articles</h2>
  </section>

  {
    articles.map((article: any) => (
      <section>
        <div style="margin-left: 100px">
          <span>
            {new Date(article.frontmatter.pubDate)
              .toLocaleDateString("en-US", {
                weekday: "long",
                month: "long",
                day: "numeric",
                year: "numeric",
              })
              .toUpperCase()}
          </span>
          <a href={article.url}>
            <h2>{article.frontmatter.title}</h2>
          </a>
        </div>
      </section>
    ))
  }

  <section>
    <div class="row gap-4">
      <a class="w-text-3xl" href="https://github.com/richgrov">
        <img src="/ic/github.png" alt="GitHub Icon" />
      </a>
      <a class="w-text-3xl" href="https://www.linkedin.com/in/richgrov/">
        <img src="/ic/linkedin.png" alt="LinkedIn Icon" />
      </a>
      <a class="w-text-3xl" href="https://www.x.com/richgrov">
        <img src="/ic/x.png" alt="X Icon" />
      </a>
    </div>
  </section>
</Layout>

<script>
  import * as game from "../game";

  var gameInitialized = false;

  document.onkeydown = (e) => {
    switch (e.key) {
      case "w":
      case "a":
      case "s":
      case "d":
        e.preventDefault();
        break;
      default:
        return;
    }

    if (gameInitialized) {
      return;
    }

    gameInitialized = true;
    game.start();
  };
</script>
